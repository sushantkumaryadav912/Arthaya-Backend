# Server Settings
ENV=development
HOST=0.0.0.0
PORT=8000
PUBLIC_URL=https://arthaya-backend.onrender.com
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://arthaya.vercel.app"]

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arthaya_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arthaya_db

# n8n Orchestrator Instance
N8N_BASE_URL=https://n8n.sushantkumaryadav.com.np
N8N_WEBHOOK_URL=https://n8n.sushantkumaryadav.com.np/webhook/arthaya-orchestrator
N8N_API_KEY=

# LLM Model Gateway API Keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
